export type CommandSpec = Readonly<{ executable: string; args: readonly string[]; cwd?: string }>;
export type IntegrationValidation = CommandSpec & Readonly<{ timeoutSeconds: number }>;
export type TicketContext = Readonly<{ observableBehavior?: readonly string[]; acceptanceExamples?: readonly string[]; nonGoals?: readonly string[]; entryPoints?: readonly string[]; invariants?: readonly string[]; expectedValidation?: readonly string[]; unresolvedDecisions?: readonly string[] }>;

export type ThinWorker = Readonly<{ name: string; kind: string; model: string; thinking: string; tools: readonly string[] }>;
export type TicketMode = "implementation" | "review";
export type ThinTicket = Readonly<{ id: string; mode: TicketMode; goal: string; definitionOfDone: string; dependencies: readonly string[]; ownedPaths: readonly string[]; readPaths?: readonly string[]; forbiddenScope: string; worker: ThinWorker; validation: CommandSpec; requiresIntegratedBase: boolean; specPaths: readonly string[]; maxFixRounds: number; timeoutSeconds: number; validationTimeoutSeconds: number; context?: TicketContext }>;
export type ThinRun = Readonly<{ runId: string; objective: string; baseSha: string; tickets: readonly ThinTicket[]; maxConcurrency: number; contextPaths: readonly string[]; integrationValidation?: IntegrationValidation }>;
export type ThinTicketState = { status: "pending" | "running" | "reviewed" | "disposed" | "validation_passed" | "integrated" | "cleaned" | "blocked" | "failed" | "stopped" | "timed_out"; disposition?: "approve" | "changes_requested" | "blocked"; handoff?: string };

export type ReconcileObservation = Readonly<{ agentStatus?: string; identityMatches?: boolean; workspacePresent?: boolean; worktreePresent?: boolean; validationPassed?: boolean; integrationVerified?: boolean; patchIntegrated?: boolean; reviewVerdict?: "approve" | "changes_requested" | "blocked"; parentUnchanged?: boolean; worktreeUnchanged?: boolean }>;
export type ReconcileContradiction = Readonly<{ code: string; message: string }>;
export type ReconcileTicketAnalysis = Readonly<{ ticketId: string; persistedStatus: string; liveStatus: string; contradictions: readonly ReconcileContradiction[]; recommendation: Readonly<{ action: "inspect_and_retain" | "verify_patch_then_integrate" | "record_parent_disposition" | "verify_then_cleanup" | "await_scheduler" | "observe_only" | "retain_or_inspect"; mutates: false }> }>;
export type ReconcileAnalysis = Readonly<{ version: 1; tickets: readonly ReconcileTicketAnalysis[]; hasContradictions: boolean; inferredSuccess: false }>;

export function analyzeReconciliation(input: { persistedTickets?: Record<string, ThinTicketState>; liveTickets?: Record<string, ReconcileObservation>; evidenceTickets?: Record<string, ReconcileObservation>; gitTickets?: Record<string, ReconcileObservation> }): ReconcileAnalysis;
export type WeightedCriticalPath = Readonly<{ ticketIds: readonly string[] | null; durationMs: number | null; incomplete: boolean; missingTiming: readonly string[] }>;
export type RunMetrics = Readonly<{ wallTimeMs: number | null; workerTimeMs: number | null; utilization: number | null; criticalPath: WeightedCriticalPath; counts: Readonly<{ validations: number; fixes: number; blocks: number; reviews: number; cleanups: number }>; incomplete: Readonly<{ wallTime: boolean; workerTime: boolean; utilization: boolean; criticalPath: boolean }>; missingTiming: Readonly<{ wall: readonly string[]; worker: readonly string[]; criticalPath: readonly string[] }> }>;
export type RunMetricState = Readonly<{ status?: string; queuedAt?: string; settledAt?: string; reviewedAt?: string; disposedAt?: string; cleanupEvidence?: Readonly<{ cleanedAt?: string }>; timing?: Readonly<{ workerElapsedMs?: number; totalElapsedMs?: number }>; rounds?: readonly Readonly<{ validation?: unknown }>[]; fixCount?: number; reviewResult?: unknown }>;
export function weightedCriticalPath(tickets: readonly Pick<ThinTicket, "id" | "dependencies">[], states: Record<string, RunMetricState>): WeightedCriticalPath;
export function analyzeRunMetrics(input: { tickets: readonly Pick<ThinTicket, "id" | "mode" | "dependencies">[]; states: Record<string, RunMetricState>; maxConcurrency?: number }): RunMetrics;
export function validateTicketGraph(value: unknown): readonly ThinTicket[];
export function validateRunInput(value: unknown): ThinRun;
export function readyTickets(tickets: readonly ThinTicket[], states: Record<string, ThinTicketState>): string[];
export function blockedByIntegration(tickets: readonly ThinTicket[], states: Record<string, ThinTicketState>): boolean;
export type PreflightWarning = Readonly<{ code: "weak_validation" | "broad_ownership" | "thin_context"; ticketId: string; message: string }>;
export type CriticalPath = Readonly<{ ticketIds: readonly string[]; length: number }>;
export type PreviewNode = Readonly<{ id: string; mode: TicketMode; dependencies: readonly string[]; ownedPaths: readonly string[]; readPaths?: readonly string[]; requiresIntegratedBase: boolean; validation: Readonly<{ executable: string; args: readonly string[]; cwd: string; timeoutSeconds: number }>; worker: Readonly<{ model: string; thinking: string; tools: readonly string[] }>; maxFixRounds: number; timeoutSeconds: number }>;
export type TicketGraphPreview = Readonly<{ version: 1; runId: string; graph: Readonly<{ nodes: readonly PreviewNode[]; edges: readonly Readonly<{ from: string; to: string }>[] }>; initialSlots: readonly string[]; gates: Readonly<{ integrationValidation: Readonly<{ executable: string; args: readonly string[]; cwd: string; timeoutSeconds: number }> | null; integratedBase: readonly Readonly<{ ticketId: string; after: readonly string[] }>[]; reviewDisposition: readonly Readonly<{ ticketId: string; dispositionRequired: "approve"; dependenciesProceedOnlyAfterApproval: true }>[] }>; warnings: readonly PreflightWarning[]; criticalPath: CriticalPath; stopConditions: readonly string[] }>;
export function preflightWarnings(run: ThinRun): readonly PreflightWarning[];
export function unweightedCriticalPath(tickets: readonly ThinTicket[]): CriticalPath;
export function previewTicketGraph(run: ThinRun): TicketGraphPreview;
export function renderTicketGraphMarkdown(run: ThinRun): string;
export function parsePorcelainV1Z(value: string | Buffer): readonly string[];
export type ImplementationResult = Readonly<{ version: 1; ticketId: string; status: "done" | "blocked" | "failed"; summary: string; changedPaths: readonly string[]; validation: "passed" | "failed" | "not_run"; handoff: string; question: string | null }>;
export type ReviewFinding = Readonly<{ severity: "critical" | "high" | "medium" | "low"; affectedPath: string; evidence: string; disposition: "open" }>;
export type ReviewResult = Readonly<{ version: 1; ticketId: string; verdict: "approve" | "changes_requested" | "blocked"; summary: string; findings: readonly ReviewFinding[]; residualRisks: readonly string[]; question: string | null }>;
export function validateTicketResult(value: unknown, ticketId: string, mode?: "implementation"): ImplementationResult;
export function validateTicketResult(value: unknown, ticketId: string, mode: "review"): ReviewResult;
export function validateTicketResult(value: unknown, ticketId: string, mode: TicketMode): ImplementationResult | ReviewResult;
export function buildContextPacket(input: { run: ThinRun; ticket: ThinTicket; repositoryPath: string; worktreePath: string; promptPath: string; resultPath: string; nonce: string; dependencyHandoffs?: readonly { ticketId: string; handoff: string }[]; guidance?: string }): string;
